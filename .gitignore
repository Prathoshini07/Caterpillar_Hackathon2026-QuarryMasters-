# ============================================================
# CATERPILLAR SMART RENTAL TRACKING — .gitignore
# ============================================================

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.*
.env.local
.env.development
.env.production
*.env

# ----------------------------
# Python / Backend
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.log

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
venv.bak/

# SQLite / Database files
*.db
*.sqlite
*.sqlite3

# pytest / test coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# Mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# ----------------------------
# Node.js / Frontend
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
dist/
dist-ssr/
*.local

# Package lock (keep one, ignore the others)
# Uncomment the one you DON'T use:
# package-lock.json
# yarn.lock

# ----------------------------
# IDE & Editor
# ----------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ----------------------------
# OS
# ----------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
